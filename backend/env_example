# JSON list of MCP servers to connect to, e.g.
# MCP_SERVERS=[{"name": "memory", "command": "python", "args": ["-m", "lad.tools.memory_server"]}]
MCP_SERVERS=[{"name": "sandbox", "command": "python", "args": ["-m", "lad.tools.sandbox_server"]}, {"name": "web_search", "command": "python", "args": ["-m", "lad.tools.web_search_server"]}, {"name": "memory", "command": "python", "args": ["-m", "lad.tools.memory_server"]}]
MAX_TOOL_ITERATIONS=3
AGENT_MAX_TOOL_ITERATIONS=8

# Get one at https://tavily.com
TAVILY_API_KEY=your-tavily-api-key-here

SANDBOX_URL=http://sandbox:8000
